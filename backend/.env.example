# API
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clothpos
DB_USER=root
DB_PASSWORD=change-me
# keep false: schema is managed by migrations (npm run migration:run)
DB_SYNC=false
# run pending migrations automatically when the API starts
DB_MIGRATE_ON_START=true
DB_LOGGING=false

# JWT - use long random strings in production
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7

# set true behind HTTPS so the refresh cookie is only sent over TLS
COOKIE_SECURE=false
